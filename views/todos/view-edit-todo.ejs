<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>View/Edit Todo</title>
    <script src="/js/todos.js" defer></script>
    <link rel="stylesheet" href="/css/layout.css">
    <link rel="stylesheet" href="/css/sidebar.css">
    <link rel="stylesheet" href="/css/variables.css">
    <link rel="stylesheet" href="/css/forms.css">
</head>
<body>
    <div class="app-shell">
        <%- include('../partials/sidebar.ejs') %>
        <main class="page-content">
            <div class="page-header">
                <h1><%= foundTodo.name %></h1>
                <form action="/todos/<%= foundTodo._id %>?_method=DELETE" method="post" id="deleteTodoForm">
                    <button type="submit" class="btn-delete">Delete Todo</button>
                </form>
            </div>

            <form action="/todos/<%= foundTodo._id %>?_method=PUT" method="post" id="todoForm">
                <p class="section-label">Checklist</p>
                <div class="box">
                    <%- include('../partials/todo-form.ejs', { todo: foundTodo }) %>
                </div>
                

                <div class="form-actions">
                    <button type="submit" class="btn-save">Save Changes</button>
                    <a href="/todos/<%= foundTodo._id %>" class="btn-cancel">Cancel</a>
                </div>
            </form>
        </main>
    </div>
</body>
</html>