<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Learning Entries</title>
    <link rel="stylesheet" href="css/style.css">
    <link rel="stylesheet" href="/css/layout.css">
    <link rel="stylesheet" href="/css/sidebar.css">
    <link rel="stylesheet" href="/css/variables.css">
    <link rel="stylesheet" href="/css/forms.css">
</head>
<body>
    <div class="app-shell">
        <%- include('../partials/sidebar.ejs') %>
        <main class="page-content">
            <div class="list-header">
                <div>
                    <h1>Learning Entries</h1>
                    <p class="page-sub">All saved Learning Entries</p>
                </div>
                <a href="/learnings/new" class="btn-new">+ New Learning</a>
            </div>

            <!-- Filter Form -->
            <form action="/learnings" method="get"> 
                <select name="area" class="filter-select">
                    <option value="">Area: All</option>
                    <% for(let area of areaEnums) {%>
                        <option value="<%= area %>"> <%= area %> </option>
                    <% } %>
                </select>

                <input type="search" name="query" class="filter-search" placeholder="Search Name">

                <button type="submit" class="btn-save">Filter</button>
                <a href="/learnings" class="btn-cancel">Clear</a>
            </form>

            <div class="entries-container">
            <% for (learning of allLearnings) { %>
                <div>
                    <h2><%= learning.name %></h2>
                    <p><b><%= learning.notes  %></b></p>
                    <p><b><%= learning.area  %></b></p>
                    <% for (job of learning.linkedJobs) { %>
                    <p><b><%= job.title  %></b></p>
                    <% } %>

                    <div class="entry-buttons">
                        <a href="/learnings/<%= learning._id %>/edit"><button>Edit Entry</button></a>
                        <form action="/learnings/<%= learning._id %>?_method=DELETE" method="post">
                            <button>Delete Entry</button>
                        </form>
                        
                    </div>
                </div>
            <% } %>
            </div>
        </main>
    </div>
</body>
</html>