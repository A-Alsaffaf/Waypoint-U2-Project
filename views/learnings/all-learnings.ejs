<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Learning Entries</title>
    <link rel="stylesheet" href="/css/variables.css">
    <link rel="stylesheet" href="/css/layout.css">
    <link rel="stylesheet" href="/css/sidebar.css">
    <link rel="stylesheet" href="/css/forms.css">
    <link rel="stylesheet" href="/css/learnings.css">
    <link rel="shortcut icon" href="/assets/favicon-32.png" type="image/png">
</head>
<body>
    <div class="app-shell">
        <%- include('../partials/sidebar.ejs') %>
        <main class="page-content">
            <div class="list-header">
                <div>
                    <h1>Learning Entries</h1>
                    <p class="page-sub">All saved Learning Entries</p>
                </div>
                <a href="/learnings/new" class="btn-new">+ New Learning</a>
            </div>

            <!-- Filter Form -->
            <form action="/learnings" method="get"> 
                <select name="area" class="filter-select">
                    <option value="">Area: All</option>
                    <% for(let area of areaEnums) {%>
                        <option value="<%= area %>"> <%= area %> </option>
                    <% } %>
                </select>

                <input type="search" name="query" class="filter-search" placeholder="Search Name">

                <button type="submit" class="btn-save">Filter</button>
                <a href="/learnings" class="btn-cancel">Clear</a>
            </form>

            <div class="learning-list">

                <% if (allLearnings.length === 0) { %>
                    <p class="learning-empty">No learning entries yet.</p>
                <% } %>

                <% allLearnings.forEach(entry => { %>
                    <article class="learning-card">

                        <div class="learning-card-main">
                            <a class="learning-card-title" href="/learnings/<%= entry._id %>"><%= entry.name %></a>
                            <% if (entry.notes) { %>
                                <p class="learning-card-notes"><%= entry.notes %></p>
                            <% } %>
                        </div>

                        <span class="learning-badge"><%= entry.area %></span>

                        <% if (entry.linkedJobs.length > 0) { %>
                            <span class="learning-badge learning-badge--accent">
                                <%= entry.linkedJobs.length %> <%= entry.linkedJobs.length === 1 ? 'job' : 'jobs' %>
                            </span>
                        <% } %>

                        <div class="learning-actions">
                            <a class="learning-action" href="/learnings/<%= entry._id %>/edit" title="Edit">✎</a>

                            <form action="/learnings/<%= entry._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this entry?')">
                                <button class="learning-action learning-action--delete" type="submit" title="Delete">✕</button>
                            </form>
                        </div>

                    </article>
                <% }) %>

            </div>
        </main>
    </div>
</body>
</html>