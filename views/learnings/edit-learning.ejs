<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Learning</title>
    <link rel="stylesheet" href="/css/variables.css">
    <link rel="stylesheet" href="/css/layout.css">
    <link rel="stylesheet" href="/css/sidebar.css">
    <link rel="stylesheet" href="/css/forms.css">
    <link rel="shortcut icon" href="/assets/favicon-32.png" type="image/png">
</head>
<body>
    <div class="app-shell">
        <%- include('../partials/sidebar.ejs') %>
        <main class="page-content">
            <h1>Edit Learning Entry</h1>

            <form action="/learnings/<%= toUpdateLearning._id %>?_method=PUT" method="post">
                <div class="field">
                    <label for="learningName">Name<span class="required-mark">*</span></label>
                    <input type="text" id="learningName" name="name" value="<%= toUpdateLearning.name  %>">
                </div>
                <div class="field notes-field">
                    <label for="notes">Notes<span class="required-mark">*</span></label>
                    <textarea name="notes" id="notes"><%= toUpdateLearning.notes %></textarea>
                </div>
                <div class="field">
                    <label for="learningArea">Learning Area<span class="required-mark">*</span></label>
                    <select name="area" id="learningArea">
                        <% for(area of areaEnums) { %>
                            <% if (area == toUpdateLearning.area){ %>
                                <option selected value="<%= area %>"><%= area %></option>
                            <% }else { %>
                                <option value="<%= area %>"><%= area %></option>
                            <% } %>
                        <% } %>
                    </select>
                </div>
                <div class="optional-section">
                    <p class="optional-section-label">Additional details (optional)</p>
                    <div class="field">
                        <label for="resourceLink">Resource URL</label>
                        <input type="text" name="resourceLink" id="resourceLink" value="<%= toUpdateLearning.resourceLink %>">
                    </div>
                    <div class="field">
                        <label for="linkedJobs">Link Jobs</label>
                        <select multiple name="linkedJobs" id="linkedJobs">
                            <!-- <% for(let job of availableJobs) { %>
                                <% if (job == toUpdateLearning.linkedJobs) %>
                                <option value="<%= job._id %>"><%= job.title  %></option>
                            <% } %> -->

                            <% for (let i = 0; i < availableJobs.length; i++) { %>
                                <% if (availableJobs[i] == toUpdateLearning.linkedJobs[i]) { %>
                                    <option selected value="<%= availableJobs[i]._id %>"><%= availableJobs[i].title  %></option>
                                <% } else { %>
                                    <option value="<%= availableJobs[i]._id %>"><%= availableJobs[i].title  %></option>
                                <% } %>
                            <% } %>
                        </select>
                    </div>
                </div>

                <button class="btn-save" type="submit">Save Learning Entry</button>
                <a class="btn-cancel" href="/jobs">Cancel</a>

            </form>
        </main>
    </div>
</body>
</html>