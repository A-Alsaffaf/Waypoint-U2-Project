<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Learning Details</title>
    <script src="/js/todos.js" defer></script>
    <link rel="stylesheet" href="/css/variables.css">
    <link rel="stylesheet" href="/css/layout.css">
    <link rel="stylesheet" href="/css/sidebar.css">
    <link rel="stylesheet" href="/css/forms.css">
    <link rel="stylesheet" href="/css/detail.css">
    <link rel="shortcut icon" href="/assets/favicon-32.png" type="image/png">
    
</head>
<body>
    <div class="app-shell">
        <%- include('../partials/sidebar.ejs') %>
        <main class="page-content">
            <div class="detail-head">
                <h1 class="detail-title"><%= learning.name %></h1>

                <div class="detail-actions">
                    <a class="btn-cancel" href="/learnings/<%= learning._id %>/edit">Edit</a>

                    <form action="/learnings/<%= learning._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this entry?')">
                        <button class="btn-delete" type="submit">Delete</button>
                    </form>
                </div>
            </div>

            <div class="detail-layout">
                <div class="detail-main">
                    <div class="notes-box">
                        <div class="notes-head">
                            <h2 class="section-label">Notes</h2>
                            <a class="btn-ghost" href="/learnings/<%= learning._id %>/notes">Read full notes →</a>
                        </div>

                        <% if (learning.notes) { %>
                            <div class="notes-pre notes-pre-cap"><div class="markdown-body"><%- notes %></div></div> <!-- this has to be inline, with no breaking, breaking would create a top gap -->
                        <% } else { %>
                            <p class="notes-empty">No notes yet.</p>
                        <% } %>
                    </div>

                    <%- include('../partials/todo-mini', { todo }) %>
                    
                </div>

                <div class="detail-box">
                    <div class="detail-row">
                        <span class="dt">Area</span>
                        <span class="dd"><%= learning.area %></span>
                    </div>

                    <% if (learning.resourceLink) { %>
                        <div class="detail-row">
                            <span class="dt">Resource Link</span>
                            <a class="dd" href="<%= learning.resourceLink %>" target="_blank" rel="noopener"><%= learning.resourceLink %></a>
                        </div>
                    <% } %>

                    <h2 class="section-label">Linked Jobs</h2>

                    <% if (learning.linkedJobs.length === 0) { %>
                        <p class="notes-empty">No linked jobs.</p>
                    <% } %>

                    <div class="chip-list">
                        <% learning.linkedJobs.forEach(job => { %>
                            <% if (!job.isDeleted) { %>
                                <a class="chip" href="/jobs/<%= job._id %>"><%= job.title %> @ <%= job.company %></a>
                            <% } %>
                        <% }) %>
                    </div>
                </div>
                </div>

                

        </main>
    </div>
</body>
</html>