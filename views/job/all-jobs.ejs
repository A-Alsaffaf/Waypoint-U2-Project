<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>all jobs</title>
    <link rel="stylesheet" href="/css/variables.css">
    <link rel="stylesheet" href="/css/layout.css">
    <link rel="stylesheet" href="/css/sidebar.css">
    <link rel="stylesheet" href="/css/forms.css">
    <link rel="stylesheet" href="/css/jobs.css">
    <link rel="shortcut icon" href="/assets/favicon-32.png" type="image/png">
</head>
<body>
    <div class="app-shell">
        <%- include('../partials/sidebar.ejs') %>
        <main class="page-content">
            <div class="list-header">
                <div>
                    <h1>Job Entries</h1>
                    <p class="page-sub">All saved job listings</p>
                </div>
                <a href="/jobs/new" class="btn-new">+ New Job</a>
            </div>
            <!-- Filter Form -->
            <form action="/jobs" method="get"> 
                <select name="status" class="filter-select">
                    <option value="">Status: All</option>
                    <% for(let status of statusElements) {%>
                        <option value="<%= status %>"> <%= status %> </option>
                    <% } %>
                </select>

                <select name="type" class="filter-select">
                    <option value="">Type: All</option>
                    <% for(let type of jobTypes) { %>
                        <option value="<%= type %>"> <%= type %> </option>
                    <% } %>
                </select>

                <input type="search" name="query" class="filter-search" placeholder="Search title or company">


                <button type="submit" class="btn-save">Filter</button>
                <a href="/jobs" class="btn-cancel">Clear</a>
            </form>

            <div class="job-list">

                <% if (allJobs.length === 0) { %>
                    <p class="job-empty">No job entries yet.</p>
                <% } %>

                <% allJobs.forEach(job => { %>
                    <article class="job-card">

                        <div class="job-card-main">
                            <a class="job-card-title" href="/jobs/<%= job._id %>"><%= job.title %></a>
                            <p class="job-card-notes">
                                <%= job.company %><% if (job.location) { %> · <%= job.location %><% } %>
                            </p>
                        </div>

                        <span class="job-badge"><%= job.jobType %></span>

                        <span class="job-badge <%= job.status === 'Interview Scheduled' ? 'job-badge--accent' : '' %>">
                            <%= job.status %>
                        </span>

                        <% if (job.learningEntries.length > 0) { %>
                            <span class="job-badge job-badge--accent">
                                <%= job.learningEntries.length %>
                                <%= job.learningEntries.length === 1 ? 'learning' : 'learnings' %>
                            </span>
                        <% } %>

                        <div class="job-actions">
                            <a class="job-action" href="/jobs/<%= job._id %>/edit" title="Edit">✎</a>

                            <form action="/jobs/<%= job._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this job?')">
                                <button class="job-action job-action--delete" type="submit" title="Delete">✕</button>
                            </form>
                        </div>

                    </article>
                <% }) %>

            </div>
        </main>
    </div>
</body>
</html>