<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>all jobs</title>
    <link rel="stylesheet" href="css/style.css">
    <link rel="stylesheet" href="/css/layout.css">
    <link rel="stylesheet" href="/css/sidebar.css">
    <link rel="stylesheet" href="/css/variables.css">
    <link rel="stylesheet" href="/css/forms.css">
</head>
<body>
    <div class="app-shell">
        <%- include('../partials/sidebar.ejs') %>
        <main class="page-content">
            <div class="list-header">
                <div>
                    <h1>Job Entries</h1>
                    <p class="page-sub">All saved job listings</p>
                </div>
                <a href="/jobs/new" class="btn-new">+ New Job</a>
            </div>

            <form action="/jobs" method="get">
                <select name="status" class="filter-select">
                    <option value="">Status: All</option>
                    <% for(let status of statusElements) {%>
                        <option value="<%= status %>"> <%= status %> </option>
                    <% } %>
                </select>

                <select name="type" class="filter-select">
                    <option value="">Type: All</option>
                    <% for(let type of jobTypes) { %>
                        <option value="<%= type %>"> <%= type %> </option>
                    <% } %>
                </select>

                <input type="search" name="query" class="filter-search" placeholder="Search title or company">


                <button type="submit" class="btn-save">Filter</button>
                <a href="/jobs" class="btn-cancel">Clear</a>
            </form>

            <div class="entries-container">
            <% for (job of allJobs) { %>
                <div>
                    <h2><%= job.title %></h2>
                    <p><b><%= job.company  %></b></p>
                    <p><b><%= job.jobType  %></b></p>
                    <p><b><%= job.status  %></b></p>

                    <div class="entry-buttons">
                        <a href="/jobs/<%= job._id %>/edit"><button>Edit Entry</button></a>
                        <form action="/jobs/<%= job._id %>?_method=DELETE" method="post">
                            <button>Delete Entry</button>
                        </form>
                        
                    </div>
                </div>
            <% } %>
            </div>
        </main>
    </div>
</body>
</html>